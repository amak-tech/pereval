{
  "name": "pereval-web",
  "version": "0.1.0",
  "private": true,
  "description": "Перевал — лендинг, личный кабинет и API (pereval.top)",
  "scripts": {
    "catalog": "python3 ../src/generate.py ../services.yaml -q",
    "og-image": "pnpm catalog && node scripts/og-image.mjs",
    "predev": "pnpm og-image",
    "dev": "next dev",
    "prebuild": "pnpm og-image",
    "build": "next build && pnpm build:jobs",
    "build:jobs": "esbuild src/jobs/index.ts scripts/admin.ts scripts/migrate.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs --entry-names=[name]",
    "start": "next start",
    "jobs": "tsx src/jobs/index.ts",
    "admin": "tsx scripts/admin.ts",
    "lava:mock": "tsx scripts/lava-mock-webhook.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm catalog",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.4.0",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.27",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
