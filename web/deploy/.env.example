# Перевал control plane — переменные окружения (скопируйте в web/.env на сервере, права 0600)

# --- сайт ---
PUBLIC_ORIGIN=https://pereval.top
SITE_DOMAIN=pereval.top
# --- единый TLS-сертификат (./deploy/issue-cert.sh, DNS-01 вручную) ---
# имена: SITE_DOMAIN, *.SITE_DOMAIN, *.PRO_DOMAIN + CERT_EXTRA_DOMAINS (устаревшие Free-имена вне зоны сайта)
CERTBOT_EMAIL=admin@portbuddy.dev
CERT_EXTRA_DOMAINS=pereval.portbuddy.tech
FREE_DOMAIN=free.pereval.top
FREE_DNS_IP=153.80.200.170
PRO_DOMAIN=pro.pereval.top
PRO_DNS_IP=
GA_MEASUREMENT_ID=G-3BY15ZZD8D
SELLER_LEGAL=

# --- база (пароль пользователя postgres в compose) ---
POSTGRES_PASSWORD=change-me-long-random

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=change-me-32-bytes-base64
AUTH_TRUST_HOST=true
# OAuth-клиент Google Cloud Console, redirect URI: https://pereval.top/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SESSION_DAYS=30

# --- подписка ---
GRACE_DAYS=3
TOKEN_ROTATION_GRACE_HOURS=48
ACL_DYNAMIC_TTL_MINUTES=120
MAX_BOUND_IPS=3

# --- lava.top ---
LAVA_API_KEY=
LAVA_BASE_URL=https://gate.lava.top
LAVA_OFFER_ID_PRO=
LAVA_PRODUCT_ID_PRO=
# ключ, который вы указали в lava.top при создании вебхука (метод «API key» → заголовок X-Api-Key)
LAVA_WEBHOOK_KEY=
LAVA_WEBHOOK_IP_ALLOWLIST=158.160.60.174
# enforce | log | off
LAVA_WEBHOOK_IP_MODE=log
# UNLIMINT | PAYPAL | STRIPE — провайдер для USD
LAVA_USD_METHOD=UNLIMINT
# 1 = эмуляция lava.top (только для разработки!)
LAVA_MOCK=

# --- почта ---
SMTP_HOST=smtp-pulse.com
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@pereval.top
MAIL_FROM_NAME=Перевал
ADMIN_EMAIL=admin@portbuddy.dev
